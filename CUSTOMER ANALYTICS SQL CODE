-- 1.1 COUNT() - Total Orders
SELECT COUNT(*) AS Total_Orders
FROM Orders;

-- 1.2 SUM() - Total Sales
SELECT SUM(Total_Amount) AS Total_Sales
FROM Orders;

-- 1.3 AVG() - Average Order Amount
SELECT AVG(Total_Amount) AS Average_Order_Amount
FROM Orders;

-- 1.4 MIN() - Lowest Order Amount
SELECT MIN(Total_Amount) AS Lowest_Order_Amount
FROM Orders;

-- 1.5 MAX() - Highest Order Amount
SELECT MAX(Total_Amount) AS Highest_Order_Amount
FROM Orders;
SELECT
    COUNT(Order_ID) AS Total_Orders,
    SUM(Total_Amount) AS Total_Sales,
    AVG(Total_Amount) AS Average_Sales
FROM Orders;
SELECT
    C.ID AS Customer_ID,
    C.NAME AS Customer_Name,
    COUNT(O.Order_ID) AS Total_Orders,
    SUM(O.Total_Amount) AS Total_Purchase_Amount
FROM Customer C
LEFT JOIN Orders O
ON C.ID = O.Customer_ID
GROUP BY C.ID, C.NAME
ORDER BY Total_Purchase_Amount DESC;
SELECT *
FROM (
    SELECT
        C.ID AS Customer_ID,
        C.NAME AS Customer_Name,
        SUM(O.Total_Amount) AS Total_Purchase_Amount
    FROM Customer C
    JOIN Orders O
    ON C.ID = O.Customer_ID
    GROUP BY C.ID, C.NAME
    ORDER BY Total_Purchase_Amount DESC
)
WHERE ROWNUM <= 5;
SELECT
    P.ProductID,
    P.ProductName,
    SUM(OD.Quantity) AS Total_Quantity_Sold
FROM Product P
JOIN Order_Details OD
ON P.ProductID = OD.Product_ID
GROUP BY P.ProductID, P.ProductName
ORDER BY Total_Quantity_Sold DESC;
SELECT
    P.ProductID,
    P.ProductName,
    SUM(OD.Subtotal) AS Product_Sales_Amount
FROM Product P
JOIN Order_Details OD
ON P.ProductID = OD.Product_ID
GROUP BY P.ProductID, P.ProductName
ORDER BY Product_Sales_Amount DESC;
SELECT
    P.Category,
    SUM(OD.Subtotal) AS Category_Sales
FROM Product P
JOIN Order_Details OD
ON P.ProductID = OD.Product_ID
GROUP BY P.Category
ORDER BY Category_Sales DESC;
SELECT
    C.ID AS Customer_ID,
    C.NAME AS Customer_Name,
    O.Order_ID,
    O.Order_Date,
    P.ProductName,
    P.Category,
    OD.Quantity,
    OD.Unit_Price,
    OD.Subtotal AS Amount_Generated
FROM Customer C
JOIN Orders O
ON C.ID = O.Customer_ID
JOIN Order_Details OD
ON O.Order_ID = OD.Order_ID
JOIN Product P
ON OD.Product_ID = P.ProductID
ORDER BY O.Order_Date DESC;
