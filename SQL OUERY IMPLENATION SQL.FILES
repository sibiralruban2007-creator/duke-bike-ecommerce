-- Display All Products
SELECT * FROM Products;

-- Display Available Inventory
SELECT * FROM Inventory
WHERE Availability = 'Available';

-- Display Unavailable Products
SELECT P.Product_ID, P.Product_Name,
       I.Stock_Quantity, I.Availability
FROM Products P
JOIN Inventory I ON P.Product_ID = I.Product_ID
WHERE I.Availability = 'Unavailable';

-- Products Priced Below 100000
SELECT * FROM Products
WHERE Price < 100000;

-- Products from Lowest to Highest Price
SELECT * FROM Products
ORDER BY Price ASC;

-- Display All Customers
SELECT * FROM Customers;

-- Display Customer Orders
SELECT O.Order_ID, C.Customer_Name,
       O.Order_Date, O.Total_Amount
FROM Orders O
JOIN Customers C
ON O.Customer_ID = C.Customer_ID
ORDER BY O.Order_Date;

-- Product Order Report
SELECT P.Product_Name,
       SUM(OD.Quantity) AS Total_Quantity,
       SUM(OD.Quantity * OD.Price) AS Total_Sales
FROM Products P
JOIN Order_Details OD
ON P.Product_ID = OD.Product_ID
GROUP BY P.Product_ID, P.Product_Name;

-- Customer-wise Total Orders
SELECT C.Customer_ID, C.Customer_Name,
       COUNT(O.Order_ID) AS Total_Orders
FROM Customers C
LEFT JOIN Orders O
ON C.Customer_ID = O.Customer_ID
GROUP BY C.Customer_ID, C.Customer_Name;

-- Customer-wise Total Purchase Amount
SELECT C.Customer_ID, C.Customer_Name,
       COALESCE(SUM(O.Total_Amount), 0) AS Total_Purchase
FROM Customers C
LEFT JOIN Orders O
ON C.Customer_ID = O.Customer_ID
GROUP BY C.Customer_ID, C.Customer_Name;

-- Update Inventory Stock
UPDATE Inventory
SET Stock_Quantity = 8,
    Availability = 'Available'
WHERE Inventory_ID = 2;

-- Display Final Inventory Report
SELECT P.Product_Name, S.Seller_Name,
       I.Stock_Quantity, I.Availability
FROM Inventory I
JOIN Products P ON I.Product_ID = P.Product_ID
JOIN Sellers S ON I.Seller_ID = S.Seller_ID;
